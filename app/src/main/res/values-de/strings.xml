    <string name="setting_device_preset">[Deutsch] Device Preset</string>
    <string name="tooltip_device_preset">[Deutsch] Select target reader screen dimensions and pixel density (-dev, -w, -h, -dpi).</string>
    <string name="setting_conversion_mode">[Deutsch] Conversion Mode (-mode)</string>
    <string name="tooltip_conversion_mode">[Deutsch] Maps to -mode (default, fw, 2col, copy, crop, tm, concat). Controls how columns and lines are unwrapped.</string>
    <string name="setting_max_columns">[Deutsch] Max Columns (-col)</string>
    <string name="tooltip_max_columns">[Deutsch] Maps to -col (1, 2, 4). Maximum number of columns detected per page.</string>
    <string name="setting_wrap_text">[Deutsch] Textumbruch (Reflow) &amp; Wrap Text (-wrap)</string>
    <string name="tooltip_wrap_text">[Deutsch] Maps to -wrap+ / -wrap-. Unwraps lines to fit the target screen width.</string>
    <string name="setting_hyphenation">[Deutsch] Keep Hyphenation (-hy)</string>
    <string name="tooltip_hyphenation">[Deutsch] Maps to -hy+ / -hy-. Preserves or strips line-end hyphens during text wrapping.</string>
    <string name="setting_justification">[Deutsch] Text Justification (-j)</string>
    <string name="tooltip_justification">[Deutsch] Maps to -j (-1 auto, 0 left, 1 center, 2 right, 3 full justification).</string>
    <string name="setting_rtl_mode">[Deutsch] Right-to-Left Reading Order (-r2l)</string>
    <string name="tooltip_rtl_mode">[Deutsch] Maps to -r2l+ / -r2l-. Enables RTL word and column progression for Arabic, Persian, Urdu, and Hebrew.</string>
    <string name="setting_vertical_cjk">[Deutsch] Vertical CJK Text Layout</string>
    <string name="tooltip_vertical_cjk">[Deutsch] Enables right-to-left vertical column segmentation and CJK character spacing without Latin word gaps.</string>
    <string name="setting_auto_crop">[Deutsch] Auto-Crop Margin Threshold (-ac)</string>
    <string name="tooltip_auto_crop">[Deutsch] Maps to -ac. Automatically trims noisy borders and scanning artifacts.</string>
    <string name="setting_odd_even_margins">[Deutsch] Odd / Even Page Margins (-ml, -mr)</string>
    <string name="tooltip_odd_even_margins">[Deutsch] Maps to -ml, -mt, -mr, -mb with distinct gutter offsets for odd and even book pages.</string>
    <string name="setting_contrast">[Deutsch] Contrast Adjustment (-c)</string>
    <string name="tooltip_contrast">[Deutsch] Maps to -c. Increases foreground darkness relative to paper background.</string>
    <string name="setting_gamma">[Deutsch] Gamma Correction (-g)</string>
    <string name="tooltip_gamma">[Deutsch] Maps to -g. Values below 1.0 darken anti-aliased glyphs for crisp e-ink display.</string>
    <string name="setting_sharpen">[Deutsch] Sharpen Glyphs (-sh)</string>
    <string name="tooltip_sharpen">[Deutsch] Maps to -sh+ / -sh-. Applies unsharp masking to blurred scans.</string>
    <string name="setting_dither">[Deutsch] Floyd-Steinberg Dithering (-d)</string>
    <string name="tooltip_dither">[Deutsch] Maps to -d+ / -d-. Tunes grayscale halftoning for 1-bit, 2-bit, or 4-bit e-ink panels (-bpc).</string>
    <string name="setting_scan_cleanup">[Deutsch] Leptonica Scan Cleanup (-as)</string>
    <string name="tooltip_scan_cleanup">[Deutsch] Applies Leptonica deskew (-as+), morphological despeckle, background whitening, and Sauvola shadow removal before Textumbruch (Reflow).</string>
    <string name="setting_dark_eink">[Deutsch] Intelligent Dark &amp; E-Ink Inversion (-neg)</string>
    <string name="tooltip_dark_eink">[Deutsch] Maps to -neg / -neg+. Inverts page polarity while keeping figures legible.</string>
    <string name="setting_layout_engine">[Deutsch] On-Device Layout Detector</string>
    <string name="tooltip_layout_engine">[Deutsch] Uses bundled neural layout detector (with classic k2pdfopt projection-profile fallback) to tag text, tables, figures, captions, equations, and footnotes.</string>
    <string name="setting_protected_blocks">[Deutsch] Protected Tables, Figures &amp; Equations</string>
    <string name="tooltip_protected_blocks">[Deutsch] Prevents splitting or Textumbruch (Reflow)ing tables, figures, and inline math formulas; offers scale-to-fit or keep-as-image.</string>
    <string name="setting_smart_footnotes">[Deutsch] Smart Footnote Placement</string>
    <string name="tooltip_smart_footnotes">[Deutsch] Moves detected footnotes to the end of the citing paragraph, end of section, or keeps them in place.</string>
    <string name="setting_target_size">[Deutsch] Target File Size Limit (KB)</string>
    <string name="tooltip_target_size">[Deutsch] Iteratively tunes output DPI (-dpi) and bits-per-pixel (-bpc) to meet your target file size budget.</string>
    <string name="setting_output_format">[Deutsch] Output Format</string>
    <string name="tooltip_output_format">[Deutsch] Exports searchable PDF, PNG/JPEG images, Textumbruch (Reflow)able EPUB 3, semantic HTML5, Markdown, or UTF-8 TXT.</string>
    <string name="setting_raw_cli">[Deutsch] Raw Command-Line Flags</string>
    <string name="tooltip_raw_cli">[Deutsch] Pass any desktop k2pdfopt CLI flags directly to the native option parser (-mode, -dpi, -col, -ocr, -ocrlang).</string>
