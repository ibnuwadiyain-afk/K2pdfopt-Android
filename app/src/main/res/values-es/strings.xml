    <string name="tooltip_device_preset">[Español] Select target reader screen dimensions and pixel density (-dev, -w, -h, -dpi).</string>
    <string name="setting_conversion_mode">[Español] Conversion Mode (-mode)</string>
    <string name="tooltip_conversion_mode">[Español] Maps to -mode (default, fw, 2col, copy, crop, tm, concat). Controls how columns and lines are unwrapped.</string>
    <string name="setting_max_columns">[Español] Max Columns (-col)</string>
    <string name="tooltip_max_columns">[Español] Maps to -col (1, 2, 4). Maximum number of columns detected per page.</string>
    <string name="setting_wrap_text">[Español] reflujo de texto &amp; Wrap Text (-wrap)</string>
    <string name="tooltip_wrap_text">[Español] Maps to -wrap+ / -wrap-. Unwraps lines to fit the target screen width.</string>
    <string name="setting_hyphenation">[Español] Keep Hyphenation (-hy)</string>
    <string name="tooltip_hyphenation">[Español] Maps to -hy+ / -hy-. Preserves or strips line-end hyphens during text wrapping.</string>
    <string name="setting_justification">[Español] Text Justification (-j)</string>
    <string name="tooltip_justification">[Español] Maps to -j (-1 auto, 0 left, 1 center, 2 right, 3 full justification).</string>
    <string name="setting_rtl_mode">[Español] Right-to-Left Reading Order (-r2l)</string>
    <string name="tooltip_rtl_mode">[Español] Maps to -r2l+ / -r2l-. Enables RTL word and column progression for Arabic, Persian, Urdu, and Hebrew.</string>
    <string name="setting_vertical_cjk">[Español] Vertical CJK Text Layout</string>
    <string name="tooltip_vertical_cjk">[Español] Enables right-to-left vertical column segmentation and CJK character spacing without Latin word gaps.</string>
    <string name="setting_auto_crop">[Español] Auto-Crop Margin Threshold (-ac)</string>
    <string name="tooltip_auto_crop">[Español] Maps to -ac. Automatically trims noisy borders and scanning artifacts.</string>
    <string name="setting_odd_even_margins">[Español] Odd / Even Page Margins (-ml, -mr)</string>
    <string name="tooltip_odd_even_margins">[Español] Maps to -ml, -mt, -mr, -mb with distinct gutter offsets for odd and even book pages.</string>
    <string name="setting_contrast">[Español] Contrast Adjustment (-c)</string>
    <string name="tooltip_contrast">[Español] Maps to -c. Increases foreground darkness relative to paper background.</string>
    <string name="setting_gamma">[Español] Gamma Correction (-g)</string>
    <string name="tooltip_gamma">[Español] Maps to -g. Values below 1.0 darken anti-aliased glyphs for crisp e-ink display.</string>
    <string name="setting_sharpen">[Español] Sharpen Glyphs (-sh)</string>
    <string name="tooltip_sharpen">[Español] Maps to -sh+ / -sh-. Applies unsharp masking to blurred scans.</string>
    <string name="setting_dither">[Español] Floyd-Steinberg Dithering (-d)</string>
    <string name="tooltip_dither">[Español] Maps to -d+ / -d-. Tunes grayscale halftoning for 1-bit, 2-bit, or 4-bit e-ink panels (-bpc).</string>
    <string name="setting_scan_cleanup">[Español] Leptonica Scan Cleanup (-as)</string>
    <string name="tooltip_scan_cleanup">[Español] Applies Leptonica deskew (-as+), morphological despeckle, background whitening, and Sauvola shadow removal before reflujo de texto.</string>
    <string name="setting_dark_eink">[Español] Intelligent Dark &amp; E-Ink Inversion (-neg)</string>
    <string name="tooltip_dark_eink">[Español] Maps to -neg / -neg+. Inverts page polarity while keeping figures legible.</string>
    <string name="setting_layout_engine">[Español] On-Device Layout Detector</string>
    <string name="tooltip_layout_engine">[Español] Uses bundled neural layout detector (with classic k2pdfopt projection-profile fallback) to tag text, tables, figures, captions, equations, and footnotes.</string>
    <string name="setting_protected_blocks">[Español] Protected Tables, Figures &amp; Equations</string>
    <string name="tooltip_protected_blocks">[Español] Prevents splitting or reflujo de textoing tables, figures, and inline math formulas; offers scale-to-fit or keep-as-image.</string>
    <string name="setting_smart_footnotes">[Español] Smart Footnote Placement</string>
    <string name="tooltip_smart_footnotes">[Español] Moves detected footnotes to the end of the citing paragraph, end of section, or keeps them in place.</string>
    <string name="setting_target_size">[Español] Target File Size Limit (KB)</string>
    <string name="tooltip_target_size">[Español] Iteratively tunes output DPI (-dpi) and bits-per-pixel (-bpc) to meet your target file size budget.</string>
    <string name="setting_output_format">[Español] Output Format</string>
    <string name="tooltip_output_format">[Español] Exports searchable PDF, PNG/JPEG images, reflujo de textoable EPUB 3, semantic HTML5, Markdown, or UTF-8 TXT.</string>
    <string name="setting_raw_cli">[Español] Raw Command-Line Flags</string>
    <string name="tooltip_raw_cli">[Español] Pass any desktop k2pdfopt CLI flags directly to the native option parser (-mode, -dpi, -col, -ocr, -ocrlang).</string>
