    <string name="setting_conversion_mode">[Русский] Conversion Mode (-mode)</string>
    <string name="tooltip_conversion_mode">[Русский] Maps to -mode (default, fw, 2col, copy, crop, tm, concat). Controls how columns and lines are unwrapped.</string>
    <string name="setting_max_columns">[Русский] Max Columns (-col)</string>
    <string name="tooltip_max_columns">[Русский] Maps to -col (1, 2, 4). Maximum number of columns detected per page.</string>
    <string name="setting_wrap_text">[Русский] перекомпоновка текста &amp; Wrap Text (-wrap)</string>
    <string name="tooltip_wrap_text">[Русский] Maps to -wrap+ / -wrap-. Unwraps lines to fit the target screen width.</string>
    <string name="setting_hyphenation">[Русский] Keep Hyphenation (-hy)</string>
    <string name="tooltip_hyphenation">[Русский] Maps to -hy+ / -hy-. Preserves or strips line-end hyphens during text wrapping.</string>
    <string name="setting_justification">[Русский] Text Justification (-j)</string>
    <string name="tooltip_justification">[Русский] Maps to -j (-1 auto, 0 left, 1 center, 2 right, 3 full justification).</string>
    <string name="setting_rtl_mode">[Русский] Right-to-Left Reading Order (-r2l)</string>
    <string name="tooltip_rtl_mode">[Русский] Maps to -r2l+ / -r2l-. Enables RTL word and column progression for Arabic, Persian, Urdu, and Hebrew.</string>
    <string name="setting_vertical_cjk">[Русский] Vertical CJK Text Layout</string>
    <string name="tooltip_vertical_cjk">[Русский] Enables right-to-left vertical column segmentation and CJK character spacing without Latin word gaps.</string>
    <string name="setting_auto_crop">[Русский] Auto-Crop Margin Threshold (-ac)</string>
    <string name="tooltip_auto_crop">[Русский] Maps to -ac. Automatically trims noisy borders and scanning artifacts.</string>
    <string name="setting_odd_even_margins">[Русский] Odd / Even Page Margins (-ml, -mr)</string>
    <string name="tooltip_odd_even_margins">[Русский] Maps to -ml, -mt, -mr, -mb with distinct gutter offsets for odd and even book pages.</string>
    <string name="setting_contrast">[Русский] Contrast Adjustment (-c)</string>
    <string name="tooltip_contrast">[Русский] Maps to -c. Increases foreground darkness relative to paper background.</string>
    <string name="setting_gamma">[Русский] Gamma Correction (-g)</string>
    <string name="tooltip_gamma">[Русский] Maps to -g. Values below 1.0 darken anti-aliased glyphs for crisp e-ink display.</string>
    <string name="setting_sharpen">[Русский] Sharpen Glyphs (-sh)</string>
    <string name="tooltip_sharpen">[Русский] Maps to -sh+ / -sh-. Applies unsharp masking to blurred scans.</string>
    <string name="setting_dither">[Русский] Floyd-Steinberg Dithering (-d)</string>
    <string name="tooltip_dither">[Русский] Maps to -d+ / -d-. Tunes grayscale halftoning for 1-bit, 2-bit, or 4-bit e-ink panels (-bpc).</string>
    <string name="setting_scan_cleanup">[Русский] Leptonica Scan Cleanup (-as)</string>
    <string name="tooltip_scan_cleanup">[Русский] Applies Leptonica deskew (-as+), morphological despeckle, background whitening, and Sauvola shadow removal before перекомпоновка текста.</string>
    <string name="setting_dark_eink">[Русский] Intelligent Dark &amp; E-Ink Inversion (-neg)</string>
    <string name="tooltip_dark_eink">[Русский] Maps to -neg / -neg+. Inverts page polarity while keeping figures legible.</string>
    <string name="setting_layout_engine">[Русский] On-Device Layout Detector</string>
    <string name="tooltip_layout_engine">[Русский] Uses bundled neural layout detector (with classic k2pdfopt projection-profile fallback) to tag text, tables, figures, captions, equations, and footnotes.</string>
    <string name="setting_protected_blocks">[Русский] Protected Tables, Figures &amp; Equations</string>
    <string name="tooltip_protected_blocks">[Русский] Prevents splitting or перекомпоновка текстаing tables, figures, and inline math formulas; offers scale-to-fit or keep-as-image.</string>
    <string name="setting_smart_footnotes">[Русский] Smart Footnote Placement</string>
    <string name="tooltip_smart_footnotes">[Русский] Moves detected footnotes to the end of the citing paragraph, end of section, or keeps them in place.</string>
    <string name="setting_target_size">[Русский] Target File Size Limit (KB)</string>
    <string name="tooltip_target_size">[Русский] Iteratively tunes output DPI (-dpi) and bits-per-pixel (-bpc) to meet your target file size budget.</string>
    <string name="setting_output_format">[Русский] Output Format</string>
    <string name="tooltip_output_format">[Русский] Exports searchable PDF, PNG/JPEG images, перекомпоновка текстаable EPUB 3, semantic HTML5, Markdown, or UTF-8 TXT.</string>
    <string name="setting_raw_cli">[Русский] Raw Command-Line Flags</string>
    <string name="tooltip_raw_cli">[Русский] Pass any desktop k2pdfopt CLI flags directly to the native option parser (-mode, -dpi, -col, -ocr, -ocrlang).</string>
